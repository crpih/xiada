#!/bin/bash

cd training/bin
make spanish_eslora
make multilingual_eslora
make galician_xiada_escrita
make galician_xiada_oral
cd ../..

DOCKER_BUILDKIT=1 docker build --ssh default --build-arg TRAIN=false -t xiada_tagger-eslora-spanish:latest .
DOCKER_BUILDKIT=1 docker build --ssh default --build-arg TRAIN=false -t xiada_tagger-eslora-multilingual:latest .
DOCKER_BUILDKIT=1 docker build --ssh default --build-arg TRAIN=false -t xiada_tagger-corga:latest .
